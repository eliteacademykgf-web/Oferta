# Скопируйте в .env и заполните. Файл .env в git не попадает.

PORT=4010
# Публичный адрес модуля — из него собираются ссылки для клиентов.
PUBLIC_BASE_URL=http://localhost:4010
# Пароль кабинета менеджера. ОБЯЗАТЕЛЬНО поменяйте.
ADMIN_TOKEN=change-me-please
TIMEZONE=Asia/Bishkek
# Где хранятся подписи и PDF. На Railway — путь подключённого Volume, например /data.
# DATA_DIR=/data

# ---- Реквизиты компании (попадают в текст оферты и в PDF) ----
COMPANY_BRAND=Elite Academy KG
COMPANY_LEGAL_NAME=ОсОО «Elite Academy»
COMPANY_INN=__ИНН__
COMPANY_ADDRESS=г. Бишкек, __адрес__
COMPANY_PHONE=+996 __ __ __ __
COMPANY_EMAIL=info@eliteacademy.kg
COMPANY_SITE=eliteacademy.kg
COMPANY_DIRECTOR=__ФИО директора__
COMPANY_BANK=__банк, расчётный счёт__

# ---- Условия по умолчанию (менеджер может менять для каждого клиента) ----
DEFAULT_PACKAGE=Сопровождение поступления в зарубежный вуз
DEFAULT_BOOKING_FEE=10000
DEFAULT_CURRENCY=сом
DEFAULT_DISCOUNT_USD=200
DEFAULT_T2_MIN=50000
DEFAULT_T2_MAX=100000
DEFAULT_BOOKING_DAYS=14
DEFAULT_PAY_HOURS=24
DEFAULT_EXTENSION_DAYS=7
DEFAULT_REFUND_WORKDAYS=10
DEFAULT_CLAIM_DAYS=10
DEFAULT_RETENTION_YEARS=5
